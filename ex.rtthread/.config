CONFIG_CPU_RISCV=y
CONFIG_CPU_32BITS=y
CONFIG_ARCH_RISCV_RV32=y
CONFIG_RISCV_ISA_I=y
CONFIG_RISCV_ISA_M=y
CONFIG_RISCV_ISA_C=y
CONFIG_CPU_LITTLE_ENDIAN=y

#
# MCU Vendor Selection
#
# CONFIG_VENDOR_USE_NATION is not set
# CONFIG_VENDOR_USE_STMICRO is not set
CONFIG_VENDOR_USE_OPENECOS=y
# CONFIG_VENDOR_USE_NONE is not set
CONFIG_OPENECOS_STARRYSKY=y
CONFIG_STARRYSKY_USE_C2=y
CONFIG_FLASH_START=0x00000000
CONFIG_FLASH_LENGTH=16384
CONFIG_RAM_START=0x30000000
CONFIG_RAM_LENGTH=128
CONFIG_STARRYSKY_C2_CLOCK_HZ=72000000
# end of MCU Vendor Selection

#
# Compiler Options
#
CONFIG_COMPILER_GCC=y
CONFIG_COMPILER_RISCV_GCC=y
CONFIG_COMPILER_ENABLE_LTO=y
CONFIG_NO_STD_STARTFILE=y
# CONFIG_USE_DEFAULT_STARTUP is not set
CONFIG_ENABLE_FAST_STARTUP=y
# CONFIG_USE_DEFAULT_LD_SCRIPT is not set
CONFIG_CUSTOM_LD_SCRIPT_PATH="link.ld"
# CONFIG_CUSTOM_LD_SCRIPT_NEED_PROC is not set
CONFIG_STACK_LENGTH=0x1000
# CONFIG_OPTIMIZE_NONE is not set
# CONFIG_OPTIMIZE_FAST is not set
# CONFIG_OPTIMIZE_FASTER is not set
# CONFIG_OPTIMIZE_FASTEST is not set
CONFIG_OPTIMIZE_SMALLEST=y
# CONFIG_OPTIMIZE_AGGRESSIVE is not set
# end of Compiler Options

#
# Clock Configuration
#
# CONFIG_CLOCK_HSE_ENABLE is not set
# CONFIG_CLOCK_LSE_ENABLE is not set
CONFIG_CLOCK_HSI_ENABLE=y
CONFIG_CLOCK_HSI_FREQ=8000000
CONFIG_CLOCK_LSI_ENABLE=y
CONFIG_CLOCK_LSI_FREQ=40000
CONFIG_CLOCK_SYSCLK_HSI=y
# CONFIG_CLOCK_SYSCLK_HSE is not set
# CONFIG_CLOCK_SYSCLK_PLL is not set
# CONFIG_CLOCK_SYSCLK_LSE is not set
# CONFIG_CLOCK_SYSCLK_LSI is not set
# CONFIG_CLOCK_PLL_ENABLE is not set
CONFIG_CLOCK_SYSCLK_FREQ=72000000
# end of Clock Configuration

#
# Memory Configuration
#

#
# Address and Size Configuration
#
# CONFIG_ENABLE_EXT_RAM is not set
# end of Address and Size Configuration

CONFIG_VTABLE_OFFSET=0x00000000

#
# Additional Memory Configuration
#
# CONFIG_ENABLE_EXEC_IN_RAM is not set
# end of Additional Memory Configuration
# end of Memory Configuration

#
# C++ Support
#
# CONFIG_CPP_SUPPORT is not set
# end of C++ Support

#
# Common Configuration
#
CONFIG_COMMON_INCLUDES=""
# end of Common Configuration

#
# Libraries Configuration
#
# CONFIG_LIBS_ADD_CJSON is not set
# CONFIG_LIBS_ADD_HEATSHRINK is not set
# CONFIG_LIBS_ADD_MICRO_ECC is not set
# CONFIG_LIBS_ADD_DIVSUFSORT is not set
# CONFIG_LIBS_ADD_MBEDTLS is not set
# CONFIG_LIBS_ADD_XXHASH is not set
# CONFIG_LIBS_ADD_SHA256 is not set
# CONFIG_LIBS_ADD_BASE64 is not set
# CONFIG_LIBS_ADD_BITMAP is not set
# CONFIG_LIBS_ADD_LLHTTP is not set
# end of Libraries Configuration

#
# Third-party configurations
#
# CONFIG_THIRD_RTOS_NONE is not set
# CONFIG_THIRD_RTOS_FREERTOS is not set
# CONFIG_THIRD_RTOS_RTTHREAD_STD is not set
CONFIG_THIRD_RTOS_RTTNANO=y
CONFIG_RT_NAME_MAX=12
# CONFIG_RT_USING_ARCH_DATA_TYPE is not set
CONFIG_RT_USING_NANO=y
# CONFIG_RT_USING_AMP is not set
# CONFIG_RT_USING_SMP is not set
CONFIG_RT_CPUS_NR=1
CONFIG_RT_ALIGN_SIZE=16
# CONFIG_RT_THREAD_PRIORITY_8 is not set
CONFIG_RT_THREAD_PRIORITY_32=y
# CONFIG_RT_THREAD_PRIORITY_256 is not set
CONFIG_RT_THREAD_PRIORITY_MAX=32
CONFIG_RT_TICK_PER_SECOND=1000
CONFIG_RT_USING_OVERFLOW_CHECK=y
CONFIG_RT_USING_HOOK=y
CONFIG_RT_HOOK_USING_FUNC_PTR=y
# CONFIG_RT_USING_HOOKLIST is not set
CONFIG_RT_USING_IDLE_HOOK=y
CONFIG_RT_IDLE_HOOK_LIST_SIZE=4
CONFIG_IDLE_THREAD_STACK_SIZE=1024
# CONFIG_RT_USING_TIMER_SOFT is not set
# CONFIG_RT_USING_CPU_USAGE_TRACER is not set
# CONFIG_RT_USING_TINY_FFS is not set
CONFIG_RT_USING_SEMAPHORE=y
CONFIG_RT_USING_MUTEX=y
CONFIG_RT_USING_EVENT=y
CONFIG_RT_USING_MAILBOX=y
CONFIG_RT_USING_MESSAGEQUEUE=y
# CONFIG_RT_USING_SIGNALS is not set
CONFIG_RT_USING_MEMPOOL=y
CONFIG_RT_USING_SMALL_MEM=y
# CONFIG_RT_USING_SLAB is not set
# CONFIG_RT_USING_MEMHEAP is not set
CONFIG_RT_USING_SMALL_MEM_AS_HEAP=y
# CONFIG_RT_USING_MEMHEAP_AS_HEAP is not set
# CONFIG_RT_USING_SLAB_AS_HEAP is not set
# CONFIG_RT_USING_USERHEAP is not set
# CONFIG_RT_USING_NOHEAP is not set
# CONFIG_RT_USING_MEMTRACE is not set
# CONFIG_RT_USING_HEAP_ISR is not set
CONFIG_RT_USING_HEAP=y
# CONFIG_RT_USING_INTERRUPT_INFO is not set
CONFIG_RT_USING_CONSOLE=y
CONFIG_RT_CONSOLEBUF_SIZE=128
CONFIG_RT_CONSOLE_DEVICE_NAME="sys_uart"
# CONFIG_RT_USING_USER_MAIN is not set
CONFIG_RT_USING_MSH=y
CONFIG_RT_USING_FINSH=y
CONFIG_FINSH_USING_MSH=y
CONFIG_FINSH_THREAD_NAME="tshell"
CONFIG_FINSH_THREAD_PRIORITY=20
CONFIG_FINSH_THREAD_STACK_SIZE=2048
CONFIG_FINSH_USING_HISTORY=y
CONFIG_FINSH_HISTORY_LINES=5
# CONFIG_FINSH_USING_WORD_OPERATION is not set
# CONFIG_FINSH_USING_FUNC_EXT is not set
CONFIG_FINSH_USING_SYMTAB=y
CONFIG_FINSH_CMD_SIZE=80
CONFIG_MSH_USING_BUILT_IN_COMMANDS=y
CONFIG_FINSH_USING_DESCRIPTION=y
# CONFIG_FINSH_ECHO_DISABLE_DEFAULT is not set
# CONFIG_FINSH_USING_AUTH is not set
CONFIG_FINSH_ARG_MAX=10
CONFIG_FINSH_USING_OPTION_COMPLETION=y

