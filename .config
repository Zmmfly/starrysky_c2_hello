CONFIG_CPU_RISCV=y
CONFIG_CPU_32BITS=y
CONFIG_ARCH_RISCV_RV32=y
CONFIG_RISCV_ISA_I=y
CONFIG_RISCV_ISA_M=y
CONFIG_RISCV_ISA_C=y
CONFIG_CPU_LITTLE_ENDIAN=y

#
# MCU Vendor Selection
#
# CONFIG_VENDOR_USE_NATION is not set
# CONFIG_VENDOR_USE_STMICRO is not set
CONFIG_VENDOR_USE_OPENECOS=y
# CONFIG_VENDOR_USE_NONE is not set
CONFIG_OPENECOS_STARRYSKY=y
CONFIG_STARRYSKY_USE_C2=y
CONFIG_FLASH_START=0x00000000
CONFIG_FLASH_LENGTH=16384
CONFIG_RAM_START=0x30000000
CONFIG_RAM_LENGTH=128
CONFIG_STARRYSKY_C2_CLOCK_HZ=72000000
# end of MCU Vendor Selection

#
# Compiler Options
#
CONFIG_COMPILER_GCC=y
CONFIG_COMPILER_RISCV_GCC=y
# CONFIG_COMPILER_ENABLE_LTO is not set
CONFIG_NO_STD_STARTFILE=y
CONFIG_USE_DEFAULT_STARTUP=y
CONFIG_ENABLE_FAST_STARTUP=y
CONFIG_USE_DEFAULT_LD_SCRIPT=y
CONFIG_STACK_LENGTH=0x400
# CONFIG_OPTIMIZE_NONE is not set
# CONFIG_OPTIMIZE_FAST is not set
# CONFIG_OPTIMIZE_FASTER is not set
# CONFIG_OPTIMIZE_FASTEST is not set
CONFIG_OPTIMIZE_SMALLEST=y
# CONFIG_OPTIMIZE_AGGRESSIVE is not set
# end of Compiler Options

#
# Clock Configuration
#
# CONFIG_CLOCK_HSE_ENABLE is not set
# CONFIG_CLOCK_LSE_ENABLE is not set
CONFIG_CLOCK_HSI_ENABLE=y
CONFIG_CLOCK_HSI_FREQ=8000000
CONFIG_CLOCK_LSI_ENABLE=y
CONFIG_CLOCK_LSI_FREQ=40000
CONFIG_CLOCK_SYSCLK_HSI=y
# CONFIG_CLOCK_SYSCLK_HSE is not set
# CONFIG_CLOCK_SYSCLK_PLL is not set
# CONFIG_CLOCK_SYSCLK_LSE is not set
# CONFIG_CLOCK_SYSCLK_LSI is not set
# CONFIG_CLOCK_PLL_ENABLE is not set
CONFIG_CLOCK_SYSCLK_FREQ=72000000
# end of Clock Configuration

#
# Memory Configuration
#

#
# Address and Size Configuration
#
# CONFIG_ENABLE_EXT_RAM is not set
# end of Address and Size Configuration

CONFIG_VTABLE_OFFSET=0x00000000

#
# Additional Memory Configuration
#
# CONFIG_ENABLE_EXEC_IN_RAM is not set
# end of Additional Memory Configuration
# end of Memory Configuration

#
# C++ Support
#
# CONFIG_CPP_SUPPORT is not set
# end of C++ Support

#
# Common Configuration
#
CONFIG_COMMON_INCLUDES=""
# end of Common Configuration

#
# Libraries Configuration
#
# CONFIG_LIBS_ADD_CJSON is not set
# CONFIG_LIBS_ADD_HEATSHRINK is not set
# CONFIG_LIBS_ADD_MICRO_ECC is not set
# CONFIG_LIBS_ADD_DIVSUFSORT is not set
# CONFIG_LIBS_ADD_MBEDTLS is not set
# CONFIG_LIBS_ADD_XXHASH is not set
# CONFIG_LIBS_ADD_SHA256 is not set
# CONFIG_LIBS_ADD_BASE64 is not set
# CONFIG_LIBS_ADD_BITMAP is not set
# CONFIG_LIBS_ADD_LLHTTP is not set
# end of Libraries Configuration

#
# Third-party configurations
#
CONFIG_THIRD_RTOS_NONE=y
# CONFIG_THIRD_RTOS_FREERTOS is not set
# CONFIG_THIRD_RTOS_RTTHREAD_STD is not set
# CONFIG_THIRD_RTOS_RTTNANO is not set
# CONFIG_THIRD_SEGGER_RTT is not set
# end of Third-party configurations
